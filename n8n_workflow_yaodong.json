        "jsCode": "const allItems = $input.all();\n\nreturn allItems.map((item, index) => {\n  const base64JD = $(\"get_jd\").item.json.content;\n  let decodedJD = \"\";\n  if (base64JD) {\n    decodedJD = Buffer.from(base64JD, 'base64').toString('utf-8');\n  }\n\n  const base64Resume = $(\"get_resume\").item.json.content;\n  let decodedResume = \"\";\n  if (base64Resume) {\n    decodedResume = Buffer.from(base64Resume, 'base64').toString('utf-8');\n  }\n\n  return {\n    json: {\n      job_description: decodedJD,\n      resume: decodedResume,\n      company_name: $(\"Filter\").item.json.companyName || \"Unknown\",\n      job_id: $(\"Filter\").item.json.id || index,\n      job_title: $(\"Filter\").item.json.title || \"Position\"\n    }\n  };\n});"
