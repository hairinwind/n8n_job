    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nreturn allItems.map(item => {\n  let rawText = item.json.text;\n  \n  let cleanJson = rawText.replace(/^```json\\s*/, '').replace(/\\s*```$/, '').trim();\n\n  try {\n    const llmResponse = JSON.parse(cleanJson);\n\n    return {\n      json: {\n        job_id: llmResponse.job_id,\n        company_name: llmResponse.company_name,\n        job_title: llmResponse.job_title,\n        tailored_resume: llmResponse.tailored_resume,\n        changelog: llmResponse.changelog\n      }\n    };\n  } catch (error) {\n    return {\n      json: {\n        error: \"JSON Parsing Failed\",\n        original_text: rawText\n      }\n    };\n  }\n});"
      },
